# ==============================================================================
# SportBooking Pro - Git Ignore Rules
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/
test_*.db
test_*.db*
*.db-journal
*.db-wal
*.db-shm

# Node.js & Frontend Build Artifacts
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.timestamp-*.mjs

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Redundant or Duplicate Databases
/sport_court.db
sport_booking.db
*.db.bak

# IDE & Editor Configuration
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS Generated Files
Thumbs.db
Desktop.ini
.DS_Store

# ==============================================================================
# Whitelist Sample Production Database (Required for Docker Evaluation)
# ==============================================================================
!backend/sport_court.db
